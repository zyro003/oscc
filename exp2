EXPERIMENT 2: Process Creation and Termination Using fork() and wait()
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;
    pid = fork();

    if (pid < 0)
    {
        printf("Process creation failed!\n");
    }
    else if (pid == 0)
    {
        printf("Child Process\n");
        printf("Child PID = %d\n", getpid());
    }
    else
    {
        wait(NULL);
        printf("Parent Process\n");
        printf("Parent PID = %d\n", getpid());
    }

    return 0;
}
