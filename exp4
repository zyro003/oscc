Round Robin Scheduling:
n = int(input("Enter number of processes: "))
bt = []

print("Enter burst time for each process:")
for i in range(n):
    bt.append(int(input(f"P{i+1}: ")))

q = int(input("Enter time quantum: "))
rem = bt.copy()
wt = [0]*n
time = 0

while any(rem):
    for i in range(n):
        if rem[i] > 0:
            if rem[i] > q:
                time += q
                rem[i] -= q
            else:
                time += rem[i]
                wt[i] = time - bt[i]
                rem[i] = 0

tat = [wt[i]+bt[i] for i in range(n)]

print("\nProcess\tBT\tWT\tTAT")
for i in range(n):
    print(f"P{i+1}\t{bt[i]}\t{wt[i]}\t{tat[i]}")

