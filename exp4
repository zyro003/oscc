SJF – Shortest Job First: 
n = int(input("Enter number of processes: "))
bt, p = [], []

print("Enter burst time for each process:")
for i in range(n):
    p.append(i+1)
    bt.append(int(input(f"P{i+1}: ")))

a = sorted(zip(bt, p))
bt, p = zip(*a)

wt = [0]*n
tat = [0]*n

for i in range(1, n):
    wt[i] = wt[i-1] + bt[i-1]

for i in range(n):
    tat[i] = wt[i] + bt[i]

print("\nProcess\tBT\tWT\tTAT")
for i in range(n):
    print(f"P{p[i]}\t{bt[i]}\t{wt[i]}\t{tat[i]}")
