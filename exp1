#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main()
{
    int pid = fork();

    if (pid == 0)
    {
        printf("Child Process\n");
        execl("/bin/ls", "ls", NULL);
        exit(0);
    }
    else
    {
        wait(NULL);
        printf("Parent Process\n");
        exit(0);
    }

    return 0;
}
