EXPERIMENT 8: Page Replacement Algorithms – FIFO, LRU and Optimal
#include <stdio.h>

int main()
{
    int p[]={1,2,3,1,4,5}, f[3], t[3];
    int n=6,c=3,i,j,k,pos,found,faults;

    // FIFO
    faults=pos=0;
    for(i=0;i<c;i++) f[i]=-1;
    for(i=0;i<n;i++)
    {
        found=0;
        for(j=0;j<c;j++) if(f[j]==p[i]) found=1;
        if(!found) { f[pos]=p[i]; pos=(pos+1)%c; faults++; }
    }
    printf("FIFO Page Faults = %d\n",faults);

    // LRU
    faults=0;
    for(i=0;i<c;i++) f[i]=-1;
    for(i=0;i<n;i++)
    {
        found=0;
        for(j=0;j<c;j++)
            if(f[j]==p[i]) { found=1; t[j]=i; }

        if(!found)
        {
            pos=0;
            for(j=0;j<c;j++)
                if(f[j]==-1) { pos=j; break; }
            if(f[pos]!=-1)
                for(j=1;j<c;j++)
                    if(t[j]<t[pos]) pos=j;
            f[pos]=p[i]; t[pos]=i; faults++;
        }
    }
    printf("LRU Page Faults = %d\n",faults);

    // Optimal
    faults=0;
    for(i=0;i<c;i++) f[i]=-1;
    for(i=0;i<n;i++)
    {
        found=0;
        for(j=0;j<c;j++) if(f[j]==p[i]) found=1;

        if(!found)
        {
            pos=0; k=0;
            for(j=0;j<c;j++)
            {
                if(f[j]==-1) { pos=j; break; }
                for(k=i+1;k<n;k++)
                    if(p[k]==f[j]) break;
                if(k>0 && (j==0 || k>0)) 
                    if(j==0 || k>0) pos=j;
            }
            int far=-1;
            for(j=0;j<c;j++)
            {
                for(k=i+1;k<n;k++)
                    if(p[k]==f[j]) break;
                if(k>far && f[j]!=-1) { far=k; pos=j; }
            }
            f[pos]=p[i]; faults++;
        }
    }
    printf("Optimal Page Faults = %d\n",faults);

    return 0;
}
