#include <stdio.h>

int main()
{
    int pages[] = {1, 2, 3, 4, 1, 2, 5, 1, 2, 3, 4, 5};
    int n = 12, frames[3], capacity = 3;
    int faults = 0, i, j, found, pos = 0;

    for(i = 0; i < capacity; i++)
        frames[i] = -1;

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < capacity; j++)
            if(frames[j] == pages[i])
                found = 1;

        if(found == 0)
        {
            frames[pos] = pages[i];
            pos = (pos + 1) % capacity;
            faults++;
            printf("Page Fault: %d\n", pages[i]);
        }
        else
            printf("Page Hit: %d\n", pages[i]);
    }

    printf("Total Page Faults = %d\n", faults);

    if(faults > n / 2)
        printf("Thrashing may occur\n");
    else
        printf("Thrashing is not detected\n");

    return 0;
}
