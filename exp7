#include <stdio.h>

int main()
{
    int a[3][3] = {{1,1,0}, {2,0,1}, {1,1,1}};
    int m[3][3] = {{2,2,1}, {3,1,2}, {2,2,2}};
    int av[3] = {2,1,1}, n[3][3], f[3] = {0}, s[3];
    int i, j, k = 0, flag;

    for(i = 0; i < 3; i++)
        for(j = 0; j < 3; j++)
            n[i][j] = m[i][j] - a[i][j];

    while(k < 3)
        for(i = 0; i < 3; i++)
            if(!f[i])
            {
                flag = 1;
                for(j = 0; j < 3; j++)
                    if(n[i][j] > av[j]) flag = 0;

                if(flag)
                {
                    s[k++] = i;
                    for(j = 0; j < 3; j++)
                        av[j] += a[i][j];
                    f[i] = 1;
                }
            }

    printf("Safe Sequence: ");
    for(i = 0; i < 3; i++)
        printf("P%d%s", s[i], i < 2 ? " -> " : "\n");

    return 0;
}
